<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentDesigner.Control.WaveformTrack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDesigner.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">

    <Grid>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <canvas:CanvasControl x:Name="WaveformCanvas"
                                  Draw="OnCanvasDraw"
                                  SizeChanged="OnCanvasSizeChanged"/>
        </Border>

        <StackPanel x:Name="LoadingIndicator"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <ProgressRing IsActive="True" Width="24" Height="24"/>
            <TextBlock x:Name="LoadingText" 
                       Text="Loading waveform..." 
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <TextBlock x:Name="NoDataText"
                   Text="No audio loaded"
                   Visibility="Visible"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Grid>
</UserControl>