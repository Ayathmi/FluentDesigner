<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentDesigner.Control.ViewportD3D12"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDesigner.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource MicrosoftYaHei}">

    <Grid>
        <Border Margin="4" CornerRadius="8">
            <SwapChainPanel x:Name="SwapChainPanelD3D12"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                <Border x:Name="GridSettingPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="8"
                    Padding="8,4"
                    CornerRadius="6"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Grid" VerticalAlignment="Center" FontSize="12"/>
                            <ToggleSwitch x:Name="GridVisibilityToggle"
                                      IsOn="True"
                                      MinWidth="0"
                                      MinHeight="0"
                                      Toggled="OnGridVisibilityToggled"/>
                        </StackPanel>

                        <Border Width="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Spacing" VerticalAlignment="Center" FontSize="12"/>
                            <NumberBox x:Name="GridSpacingInput"
                                   Value="10"
                                   Minimum="1"
                                   Maximum="512"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="1"
                                   LargeChange="10"
                                   MinWidth="80"
                                   MaxWidth="100"
                                   ValueChanged="OnGridSpacingChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Canvas x:Name="SelectionOverlayCanvas" 
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border x:Name="BoxSelectionRect"
                            Visibility="Collapsed"
                            Background="#220078D4"
                            BorderBrush="#FF0078D4"
                            BorderThickness="1"
                            CornerRadius="2"/>
                </Canvas>
            </SwapChainPanel>
        </Border>
    </Grid>
</UserControl>
