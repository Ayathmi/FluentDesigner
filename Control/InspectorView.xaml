<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentDesigner.Control.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDesigner.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    VerticalAlignment="Stretch"
    HorizontalAlignment="Stretch">

    <Grid Background="{ThemeResource CardStrokeColorDefaultBrush}" 
          CornerRadius="8"
          VerticalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch">
            <StackPanel Spacing="16" Padding="12">

                <StackPanel x:Name="ProjectPropertiesPanel" Visibility="Visible" Spacing="16">

                    <TextBlock Text="Project Properties" 
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,8"/>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Metadata" 
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Title" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="TitleTextBox" 
                                 PlaceholderText="Enter title..."
                                 TextChanged="OnTitleChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Music Artist" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="MusicArtistTextBox" 
                                 PlaceholderText="Enter music artist..."
                                 TextChanged="OnMusicArtistChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Chart Author" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="ChartAuthorTextBox" 
                                 PlaceholderText="Enter chart author..."
                                 TextChanged="OnChartAuthorChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="BPM" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="BpmTextBox" 
                                 PlaceholderText="e.g., 120 or 120-180"
                                 TextChanged="OnBpmChanged"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" Grid.Column="0">
                                <TextBlock Text="Difficulty Constant" FontSize="12" Opacity="0.7"/>
                                <NumberBox x:Name="DifficultyConstantBox"
                                       Value="1.0"
                                       Minimum="1.0"
                                       Maximum="15.0"
                                       SmallChange="0.1"
                                       LargeChange="1.0"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="OnDifficultyConstantChanged"/>
                            </StackPanel>

                            <StackPanel Spacing="4" Grid.Column="2">
                                <TextBlock Text="Difficulty" FontSize="12" Opacity="0.7"/>
                                <ComboBox x:Name="DifficultyComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnDifficultyChanged">
                                    <ComboBoxItem Content="Astral" Tag="Astral"/>
                                    <ComboBoxItem Content="Orbital" Tag="Orbital" IsSelected="True"/>
                                    <ComboBoxItem Content="Galaxa" Tag="Galaxa"/>
                                    <ComboBoxItem Content="Xenith" Tag="Xenith"/>
                                    <ComboBoxItem Content="Infold" Tag="Infold"/>
                                    <ComboBoxItem Content="Unique" Tag="Unique"/>
                                    <ComboBoxItem Content="Glitch" Tag="Glitch"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Description" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="ProjectDescriptionTextBox" 
                                 PlaceholderText="Enter project description..."
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 MaxHeight="160"
                                 TextChanged="OnProjectDescriptionChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" 
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="0,8"/>

                    <StackPanel Spacing="12">
                        <TextBlock Text="File I/O" 
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                        <StackPanel Spacing="4">
                            <Button x:Name="ImportWavButton" 
                                HorizontalAlignment="Stretch"
                                Click="OnImportWavClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="16" Height="16" Source="ms-appx:///Assets/Icons/Light/Phone.png"/>
                                    <TextBlock Text="Import WAV Audio"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="WavFileNameText" 
                                   Text="" 
                                   FontSize="11" 
                                   Opacity="0.6"
                                   Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Button x:Name="ImportCsvButton" 
                                HorizontalAlignment="Stretch"
                                Click="OnImportCsvClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="16" Height="16" Source="ms-appx:///Assets/Icons/Light/Notebook.png"/>
                                    <TextBlock Text="Import CSV Markers"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="CsvFileNameText" 
                                   Text="" 
                                   FontSize="11" 
                                   Opacity="0.6"
                                   Visibility="Collapsed"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                HorizontalAlignment="Stretch"
                                Click="OnImportLevelClicked"
                                x:Name="ImportExchangeButton"
                                ToolTipService.ToolTip="Import Chart">
                                <Image Width="16" Height="16" Source="ms-appx:///Assets/Icons/Light/TopRight.png"/>
                            </Button>

                            <Button Grid.Column="2" 
                                HorizontalAlignment="Stretch"
                                Click="OnExportExchangeClicked"
                                x:Name="ExportExchangeButton"
                                ToolTipService.ToolTip="Export Exchange File">
                                <Image Width="16" Height="16" Source="ms-appx:///Assets/Icons/Light/Upload.png"/>
                            </Button>

                            <Button Grid.Column="4" 
                                HorizontalAlignment="Stretch"
                                Click="OnExportDescriptionClicked"
                                x:Name="ExportDescriptionButton"
                                ToolTipService.ToolTip="Export Description File">
                                <Image Width="16" Height="16" Source="ms-appx:///Assets/Icons/Light/Download.png"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" 
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="0,8"/>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Statistics" 
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Objects" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="TotalObjectsText" 
                                       Text="0" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Components" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="TotalComponentsText" 
                                       Text="0" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                <TextBlock Text="Music Length" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="MusicLengthText" 
                                       Text="00:00" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                                <TextBlock Text="CSV Markers" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="CsvMarkersText" 
                                       Text="0" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NoteComponentsPanel" Visibility="Collapsed" Spacing="16">
                    <TextBlock Text="Note Components" 
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,8"/>

                    <StackPanel x:Name="ComponentsContainer" Spacing="12">
                    </StackPanel>
                    <StackPanel x:Name="AddComponentPanel" Spacing="8" Margin="0,8,0,0">
                        <DropDownButton x:Name="AddComponentButton" 
                                        HorizontalAlignment="Stretch"
                                        Content="Add Component">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AddComponentFlyout" Placement="Bottom">
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="GroupComponentsPanel" Visibility="Collapsed" Spacing="16">
                    <TextBlock Text="Group Properties" 
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,8"/>

                    <StackPanel x:Name="GroupComponentsContainer" Spacing="12">
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="MultiSelectPanel" Visibility="Collapsed" Spacing="8">
                    <local:MultiSelectPanel x:Name="MultiSelectControl"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>