<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentDesigner.Control.TimeRulerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="TimeDisplayButton"
                    Grid.Column="0"
                    Content="00:00:000"
                    Click="OnTimeDisplayClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    FontFamily="Consolas"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="4,0,0,0"/>

            <TextBox x:Name="TimeInputBox"
                     Grid.Column="0"
                     Visibility="Collapsed"
                     Width="90"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     Margin="4,0,0,0"
                     KeyDown="OnTimeInputKeyDown"
                     LostFocus="OnTimeInputLostFocus"/>

            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="2"
                        Margin="0,0,4,0">

                <Button x:Name="SetInPointButton"
                        ToolTipService.ToolTip="Set In Point"
                        Click="OnSetInPointClick"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0">
                    <Image Source="ms-appx:///Assets/Icons/Light/DArrowRight.png" Width="14" Height="14"/>
                </Button>

                <Button x:Name="SetOutPointButton"
                        ToolTipService.ToolTip="Set Out Point"
                        Click="OnSetOutPointClick"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0">
                    <Image Source="ms-appx:///Assets/Icons/Light/DArrowLeft.png" Width="14" Height="14"/>
                </Button>

                <Button x:Name="ClearSelectionButton"
                        ToolTipService.ToolTip="Clear Selection"
                        Click="OnClearSelectionClick"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0">
                    <Image Source="ms-appx:///Assets/Icons/Light/DeleteFilled.png" Width="14" Height="14"/>
                </Button>

                <ToggleButton x:Name="LoopToggleButton"
                              ToolTipService.ToolTip="Toggle Loop Playback"
                              IsChecked="True"
                              Checked="OnLoopToggleChanged"
                              Unchecked="OnLoopToggleChanged"
                              Padding="6,4"
                              Background="Transparent"
                              BorderThickness="0">
                    <Image Source="ms-appx:///Assets/Icons/Light/Refresh.png" Width="14" Height="14"/>
                </ToggleButton>

                <ToggleButton x:Name="SnapToggleButton"
                              ToolTipService.ToolTip="Toggle Playhead Snap"
                              IsChecked="True"
                              Checked="OnSnapToggleChanged"
                              Unchecked="OnSnapToggleChanged"
                              Padding="6,4"
                              Background="Transparent"
                              BorderThickness="0">
                    <Image Source="ms-appx:///Assets/Icons/Light/SwitchFilled.png" Width="14" Height="14"/>
                </ToggleButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>