<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentDesigner.Control.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDesigner.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="Timeline" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left"
                       FontSize="10"
                       Margin="12, 0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Audio" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           Grid.Column="0"
                           Margin="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <TextBlock x:Name="AudioFileNameText" 
                           Text="No file loaded" 
                           FontSize="9"
                           Margin="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Grid.Column="1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           HorizontalTextAlignment="Left"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Delay:" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12"/>
                <NumberBox Grid.Column="1" x:Name="TrackAudioDelayBox"
                           Value="0"
                           Minimum="-2000"
                           Maximum="2000"
                           SmallChange="1"
                           SpinButtonPlacementMode="Compact"
                           PlaceholderText="Milliseconds"
                           ValueChanged="OnTrackAudioDelayChanged"
                           Width="Auto"
                           Height="Auto"
                           MaxHeight="44"
                           MaxWidth="180"
                           FontSize="14"
                           Margin="4"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="Track Preview" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left"
                       Margin="12,0"
                       FontSize="12" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>

        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"  Text="CSV Markers" FontSize="12" 
                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12"/>
            <TextBlock Grid.Column="1" x:Name="CsvFileNameText" 
                       Text="No file loaded" 
                       FontSize="9"
                       Margin="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       MaxWidth="100"/>
        </Grid>

        <local:TimeRulerPanel Grid.Row="4" Grid.Column="0" x:Name="TimeRulerPanelControl"/>

        <local:WaveformTrack x:Name="WaveformTrackControl" 
                             Grid.Row="1"
                             Grid.Column="1"/>

        <local:TrackPreviewTrack Grid.Row="2" Grid.Column="1" x:Name="TrackPreviewControl"/>

        <local:CsvMarkerTrack Grid.Row="3" Grid.Column="1" x:Name="CsvMarkerTrackControl"/>

        <local:TimeRulerTrack Grid.Row="4" Grid.Column="1" x:Name="TimeRulerTrackControl"/>


        <Border Grid.RowSpan="4"
                Grid.Row="1"
                Grid.Column="1"
                x:Name="PlayheadClipBorder"
                IsHitTestVisible="False">
            <Border.Clip>
                <RectangleGeometry x:Name="PlayheadClipGeometry"/>
            </Border.Clip>
            <Canvas x:Name="PlayheadCanvas">
                <Polygon x:Name="PlayheadTopTriangle"
                         Points="0,0 6,-10 -6,-10"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         Canvas.Left="0"
                         Canvas.Top="10"/>
                <Rectangle x:Name="PlayheadLine"
                           Width="2"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                           Canvas.Left="-1"
                           Canvas.Top="0"/>
                <Polygon x:Name="PlayheadBottomTriangle"
                         Points="0,0 6,10 -6,10"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                         Canvas.Left="0"
                         Canvas.Top="0"/>
            </Canvas>
        </Border>

        <Grid Grid.RowSpan="4"
              Grid.Row="1"
              Grid.Column="1"
              x:Name="InteractionLayer"
              Background="Transparent"
              PointerPressed="OnPointerPressed"
              PointerMoved="OnPointerMoved"
              PointerReleased="OnPointerReleased"
              PointerWheelChanged="OnPointerWheelChanged"/>

        <Border Grid.RowSpan="4"
                Grid.Row="1"
                Grid.Column="1"
                x:Name="DisabledOverlay"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Opacity="0.7"
                Visibility="Visible">
        </Border>
    </Grid>
</UserControl>