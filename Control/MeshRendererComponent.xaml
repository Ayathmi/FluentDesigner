<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentDesigner.Control.MeshRendererComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDesigner.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Width="16"
                   Height="16"
                   Margin="0, 0, 8, 0"
                   Source="ms-appx:///Assets/Icons/Light/Grid.png"/>
            <TextBlock Grid.Column="1" Text="Mesh Renderer" 
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
        </Grid>

        <StackPanel Spacing="4">
            <TextBlock Text="Type" FontSize="11" Opacity="0.6"/>
            <ComboBox x:Name="NoteTypeComboBox" 
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnNoteTypeChanged">
                <ComboBoxItem Content="Click" Tag="Click"/>
                <ComboBoxItem Content="Flick" Tag="Flick"/>
                <ComboBoxItem Content="Slide" Tag="Slide"/>
                <ComboBoxItem Content="Rail" Tag="Rail"/>
                <ComboBoxItem Content="Catch" Tag="Catch"/>
                <ComboBoxItem Content="RotateL" Tag="RotateL"/>
                <ComboBoxItem Content="RotateR" Tag="RotateR"/>
                <ComboBoxItem Content="Guiding" Tag="Guiding"/>
                <ComboBoxItem Content="Mine" Tag="Mine"/>
            </ComboBox>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Visibility" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="VisibilityToggle" Grid.Column="1" 
                          IsOn="True"
                          MinWidth="0"
                          Toggled="OnVisibilityToggled"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" Grid.Column="0">
                <TextBlock Text="Sorting Layer" FontSize="11" Opacity="0.6"/>
                <NumberBox x:Name="SortingLayerBox"
                           Value="0"
                           Minimum="-100"
                           Maximum="100"
                           SmallChange="1"
                           LargeChange="10"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="OnSortingLayerChanged"/>
            </StackPanel>

            <StackPanel Spacing="4" Grid.Column="2">
                <TextBlock Text="Order in Layer" FontSize="11" Opacity="0.6"/>
                <NumberBox x:Name="OrderInLayerBox"
                           Value="0"
                           Minimum="-1000"
                           Maximum="1000"
                           SmallChange="1"
                           LargeChange="10"
                           SpinButtonPlacementMode="Compact"
                           ValueChanged="OnOrderInLayerChanged"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
