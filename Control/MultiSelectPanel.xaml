<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentDesigner.Control.MultiSelectPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:control="using:FluentDesigner.Control"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <TextBlock Text="Multiple Selection" 
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,8"/>

        <StackPanel Spacing="12">
            <TextBlock Text="Selection Info" 
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Notes" FontSize="11" Opacity="0.6"/>
                    <TextBlock x:Name="NoteCountText" 
                               Text="0" 
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Groups" FontSize="11" Opacity="0.6"/>
                    <TextBlock x:Name="GroupCountText" 
                               Text="0" 
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                    <TextBlock Text="Start Time" FontSize="11" Opacity="0.6"/>
                    <TextBlock x:Name="StartTimeText" 
                               Text="00:00:000" 
                               FontFamily="Consolas"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                    <TextBlock Text="End Time" FontSize="11" Opacity="0.6"/>
                    <TextBlock x:Name="EndTimeText" 
                               Text="00:00:000" 
                               FontFamily="Consolas"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Height="1" 
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8"/>

        <StackPanel Spacing="12">
            <TextBlock Text="Offset TargetTime" 
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                    <TextBlock Text="Min" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                        <Button x:Name="MinDecreaseBtn" Content="-" Width="32" Click="OnMinDecrease" ToolTipService.ToolTip="-1 min"/>
                        <Button x:Name="MinIncreaseBtn" Content="+" Width="32" Click="OnMinIncrease" ToolTipService.ToolTip="+1 min"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4" Margin="2,0">
                    <TextBlock Text="Sec" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                        <Button x:Name="SecDecreaseBtn" Content="-" Width="32" Click="OnSecDecrease" ToolTipService.ToolTip="-1 sec"/>
                        <Button x:Name="SecIncreaseBtn" Content="+" Width="32" Click="OnSecIncrease" ToolTipService.ToolTip="+1 sec"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" Margin="4,0,0,0">
                    <TextBlock Text="Tick" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                        <RepeatButton x:Name="TickDecreaseBtn" 
                                      Content="-" 
                                      Width="32" 
                                      Delay="300" 
                                      Interval="20"
                                      Click="OnTickDecrease" 
                                      ToolTipService.ToolTip="-1 tick"/>
                        <RepeatButton x:Name="TickIncreaseBtn" 
                                      Content="+" 
                                      Width="32" 
                                      Delay="300" 
                                      Interval="20"
                                      Click="OnTickIncrease" 
                                      ToolTipService.ToolTip="+1 tick"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Height="1" 
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8"/>

        <StackPanel Spacing="12">
            <TextBlock Text="Set Start/End Time" 
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Set Start Time (moves all notes)" FontSize="11" Opacity="0.7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StartTimeInput" 
                             PlaceholderText="00:00:000"
                             FontFamily="Consolas"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" 
                            Content="Apply" 
                            Margin="8,0,0,0"
                            Click="OnApplyStartTime"/>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Set End Time (moves all notes)" FontSize="11" Opacity="0.7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EndTimeInput" 
                             PlaceholderText="00:00:000"
                             FontFamily="Consolas"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" 
                            Content="Apply" 
                            Margin="8,0,0,0"
                            Click="OnApplyEndTime"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <Border Height="1" 
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8"/>

        <StackPanel Spacing="12">
            <TextBlock Text="Distribute Evenly" 
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="From" FontSize="11" Opacity="0.6"/>
                    <TextBox x:Name="DistributeStartInput" 
                             PlaceholderText="00:00:000"
                             FontFamily="Consolas"/>
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="→" 
                           VerticalAlignment="Center"
                           Margin="8,16,8,0"
                           FontSize="16"/>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="To" FontSize="11" Opacity="0.6"/>
                    <TextBox x:Name="DistributeEndInput" 
                             PlaceholderText="00:00:000"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Grid>

            <Button x:Name="DistributeBtn" 
                    Content="Distribute Selected Notes" 
                    HorizontalAlignment="Stretch"
                    Click="OnDistributeClick"/>
        </StackPanel>

        <Border Height="1" 
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8"/>

        <control:RailIndexCurvePanel x:Name="RailIndexCurveControl"/>
    </StackPanel>
</UserControl>