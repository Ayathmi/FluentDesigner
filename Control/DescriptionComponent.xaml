<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentDesigner.Control.DescriptionComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="ms-appx:///Assets/Icons/Light/EditPen.png"
                   Width="18"
                   Height="18"
                   Margin="0, 0, 8, 0"/>
            <TextBlock Grid.Column="1"
                       Text="Description"
                       Style="{StaticResource BodyTextBlockStyle}"/>
        </Grid>

        <StackPanel Spacing="4">
            <TextBlock Text="Text" FontSize="11" Opacity="0.6"/>
            <TextBox x:Name="DescriptionText"
                     PlaceholderText="Enter description..."
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="60"
                     TextChanged="OnDescriptionTextChanged"/>
        </StackPanel>
    </StackPanel>
</UserControl>