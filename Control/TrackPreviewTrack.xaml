<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentDesigner.Control.TrackPreviewTrack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDesigner.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">

    <Grid>
        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <canvas:CanvasControl x:Name="PreviewCanvas"
                                  Draw="OnCanvasDraw"
                                  SizeChanged="OnCanvasSizeChanged"
                                  PointerPressed="OnCanvasPointerPressed"/>
        </Border>

        <TextBlock x:Name="NoDataText"
                   Text="No notes in scene"
                   Visibility="Visible"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Grid>
</UserControl>