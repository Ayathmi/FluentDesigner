<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentDesigner.Control.TransformComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDesigner.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="ms-appx:///Assets/Icons/Light/FullScreen.png"
                   Width="18"
                   Height="18"
                   Margin="0, 0, 8, 0"/>
            <TextBlock Grid.Column="1"
                       Text="Transform"
                       Style="{StaticResource BodyTextBlockStyle}"/>
        </Grid>

        <StackPanel Spacing="4">
            <TextBlock Text="Position" FontSize="11" Opacity="0.6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PositionX" Grid.Column="0" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="X"/>
                <TextBox x:Name="PositionY" Grid.Column="2" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="Y"/>
                <TextBox x:Name="PositionZ" Grid.Column="4" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="Z"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Rotation" FontSize="11" Opacity="0.6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RotationX" Grid.Column="0" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="X"/>
                <TextBox x:Name="RotationY" Grid.Column="2" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="Y"/>
                <TextBox x:Name="RotationZ" Grid.Column="4" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="Z"/>
                <TextBox x:Name="RotationW" Grid.Column="6" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="W"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Scale" FontSize="11" Opacity="0.6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScaleX" Grid.Column="0" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="X"/>
                <TextBox x:Name="ScaleY" Grid.Column="2" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="Y"/>
                <TextBox x:Name="ScaleZ" Grid.Column="4" 
                         IsReadOnly="True" IsEnabled="False"
                         PlaceholderText="Z"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4" x:Name="RadiusPanel">
            <TextBlock Text="Radius (R)" FontSize="11" Opacity="0.6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="RadiusSlider" 
                        Minimum="0.1" Maximum="7.5" 
                        Value="7.5"
                        StepFrequency="0.1"
                        TickFrequency="1.0"
                        TickPlacement="Outside"
                        ValueChanged="OnRadiusChanged"/>
                <TextBox x:Name="RadiusText" Grid.Column="1" 
                         Text="7.5" 
                         Margin="8,0,0,0"
                         TextAlignment="Center"
                         KeyDown="OnRadiusTextKeyDown"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Rail Index" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="RotateModeCheckBox" 
                              Content="Rotate Mode" 
                              Checked="OnRotateModeChecked"
                              Unchecked="OnRotateModeUnchecked"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="RailIndexSlider" 
                        Minimum="0" Maximum="359" 
                        Value="0"
                        TickFrequency="45"
                        TickPlacement="Outside"
                        ValueChanged="OnRailIndexChanged"/>
                <TextBox x:Name="RailIndexText" Grid.Column="1" 
                         Text="0" 
                         Margin="8,0,0,0"
                         TextAlignment="Center"
                         IsReadOnly="True"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4" x:Name="ParentPanel" Visibility="Collapsed">
            <TextBlock Text="Parent" FontSize="11" Opacity="0.6"/>
            <TextBox x:Name="ParentName" 
                     IsReadOnly="True" IsEnabled="False"
                     PlaceholderText="None"/>
        </StackPanel>
    </StackPanel>
</UserControl>
